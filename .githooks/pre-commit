#!/bin/sh
# Doc/symbol check before every commit (enable once: git config core.hooksPath .githooks)
d="$(git rev-parse --show-toplevel)/landstalker"
[ -f "$d/tools/check_docs.py" ] || exit 0
# 2026-11-12: refresh the Contents blocks (tools/make_toc.py) of the big docs that are part of this commit, and stage them again
for f in HANDOFF.md INDEX.md LESSONS.md; do
  git diff --cached --quiet -- "$d/docs/$f" || { python3 "$d/tools/make_toc.py" "$d/docs/$f" >/dev/null && git add "$d/docs/$f"; }
done
python3 "$d/tools/check_docs.py" || { echo "commit blocked: fix docs/symbols.json (or git commit --no-verify)"; exit 1; }
